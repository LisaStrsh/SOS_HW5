    {
      "id": 5,
      "title": "Топ фильмов за период",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT dimension AS movie, sum(value) AS views FROM cinema.daily_metrics FINAL WHERE metric_name = 'movie_views' AND $__timeFilter(toDateTime(date, 'UTC')) GROUP BY dimension ORDER BY views DESC, movie LIMIT 10",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
