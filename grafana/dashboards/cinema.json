    },
    {
      "id": 4,
      "title": "Среднее время завершённого просмотра",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT toDateTime(date, 'UTC') AS time, value FROM cinema.daily_metrics FINAL WHERE metric_name = 'avg_watch_seconds' AND dimension = '' AND $__timeFilter(toDateTime(date, 'UTC')) ORDER BY time",
